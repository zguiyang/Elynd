{
  "name": "elynd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later OR Commercial",
  "packageManager": "pnpm@10.26.1",
  "prettier": "./prettier.config.js",
  "scripts": {
    "dev:backend": "pnpm --filter @elynd/backend dev",
    "dev:web": "pnpm --filter @elynd/web dev",
    "build": "pnpm --filter @elynd/backend build && pnpm --filter @elynd/web build",
    "build:backend": "pnpm --filter @elynd/backend build",
    "lint": "pnpm --filter @elynd/backend lint && eslint apps/web packages/shared",
    "lint:backend": "pnpm --filter @elynd/backend lint",
    "lint:web": "eslint apps/web",
    "lint:shared": "eslint packages/shared",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @elynd/shared typecheck && pnpm --filter @elynd/backend typecheck && pnpm --filter @elynd/web typecheck",
    "typecheck:backend": "pnpm --filter @elynd/backend typecheck",
    "typecheck:shared": "pnpm --filter @elynd/shared typecheck",
    "typecheck:web": "pnpm --filter @elynd/web typecheck",
    "test": "pnpm --filter @elynd/shared test && pnpm --filter @elynd/backend test && pnpm --filter @elynd/web test",
    "test:backend": "pnpm --filter @elynd/backend test",
    "test:shared": "pnpm --filter @elynd/shared test",
    "test:web": "pnpm --filter @elynd/web test",
    "compose:init": "test -f docker-compose.yaml || cp docker-compose.yaml.example docker-compose.yaml",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@elynd/backend": "workspace:*",
    "@elynd/shared": "workspace:*",
    "@elynd/web": "workspace:*",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
