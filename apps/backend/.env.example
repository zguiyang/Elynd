# Node
PORT=3333
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info

# Public web origin (CORS, Better Auth baseURL via Next /api proxy, email links)
FRONTEND_URL=http://localhost:3000

# Better Auth (secret ≥ 16 chars)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Postgres — Compose host 5433 → container 5432
DATABASE_URL=postgresql://root:root@127.0.0.1:5433/gloaming_backend

# Redis — Compose host 6380 → container 6379
REDIS_URL=redis://127.0.0.1:6380

# Mail (Resend) — omit or leave empty to log-only in local dev
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Gloaming

# AES-256 key for LLM API keys in DB (32 bytes, base64 or 64-char hex)
# Generate: openssl rand -base64 32
LLM_CONFIG_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_base64_32

# Object storage (S3-compatible). Driver `r2` needs all four R2_* vars, or omit all.
# Boot succeeds without them; article audio persistence Fail Fast until set.
OSS_DRIVER=r2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
