# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
FRONTEND_URL=http://localhost:3000

# Session — use redis in development/production for session tagging
# (invalidate all devices after password reset). Tests force SESSION_DRIVER=memory.
SESSION_DRIVER=redis

# Rate limiter store (login brute-force). Tests force LIMITER_STORE=memory.
LIMITER_STORE=redis

#--------------------------------------------------------------------
# Database (Lucid) — Compose: elynd-postgres → host 5433
#--------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=elynd_backend

#--------------------------------------------------------------------
# Redis — Compose: elynd-redis → host 6380
#--------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

#--------------------------------------------------------------------
# Mail (Resend)
#--------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Elynd

#--------------------------------------------------------------------
# CORS
#--------------------------------------------------------------------
# Browser CORS lives in config/cors.ts (dev: allow all; prod: explicit
# allowlist, empty by default). Prefer FRONTEND_URL as the production
# origin. Session cookies are same-site via the Next BFF proxy — do not
# open CORS to untrusted origins when credentials are enabled.
