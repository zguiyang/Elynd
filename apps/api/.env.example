# Nest API local environment (Compose-aligned)

PORT=3336
DATABASE_URI=postgresql://root:root@127.0.0.1:5433/app
AUTH_SECRET=dev-auth-secret-change-me-32chars-min

# Public browser origin (Next). Auth cookies are set via same-origin /api proxy.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Redis — required for API (Compose: elynd-redis → host 6380)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# Transactional mail (Resend Free). Required only when sending mail.
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM=Elynd <noreply@your-verified-domain.com>
