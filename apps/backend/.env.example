# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info

# App URLs
APP_URL=http://localhost:3333
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3333

# Database — Compose: host 5433 → container 5432
# Prefer DATABASE_URL; discrete vars are used to build it when unset.
DATABASE_URL=postgresql://root:root@127.0.0.1:5433/elynd_backend
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=elynd_backend

# Redis — Compose: host 6380 → container 6379
REDIS_URL=redis://127.0.0.1:6380
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

# Mail (Resend) — optional in local foundation
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Elynd
