{
  "name": "@elynd/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later OR Commercial",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tables": {
      "types": "./src/tables/index.ts",
      "import": "./dist/tables/index.js",
      "default": "./dist/tables/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm -w exec eslint packages/db",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "drizzle-orm": "^0.44.4",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "typescript": "^5.8.3"
  }
}
