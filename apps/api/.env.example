# Nest API local environment (Compose-aligned)

PORT=3336
DATABASE_URI=postgresql://root:root@127.0.0.1:5433/app
AUTH_SECRET=dev-auth-secret-change-me-32chars-min
BETTER_AUTH_URL=http://localhost:3336
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Redis (available from docker-compose.dev.yml; not required for auth Bearer loop)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
